function Library:Notify(data)
    if type(data) ~= 'table' then
        data = { Description = tostring(data) }
    end
    data.Title = data.Title or '<b>Astra</b>'
    data.BigIcon = data.BigIcon or 'rbxassetid://118486090436366'
    return OLD_NOTIFY(self, data)
end

